+function resolveBrowserLocalResolution(): StreamerScreenResolutionInput {
+  if (typeof window === "undefined" || !window.screen) return { width: 1920, height: 1080 };
+  const dpr = Number.isFinite(window.devicePixelRatio) && window.devicePixelRatio > 0 ? window.devicePixelRatio : 1;
+  const rawW = Math.round((window.screen.width || 0) * dpr);
+  const rawH = Math.round((window.screen.height || 0) * dpr);
+  if (rawW < 640 || rawH < 360) return { width: 1920, height: 1080 };
+  const width = Math.min(3840, Math.max(1280, rawW - (rawW % 2)));
+  const height = Math.min(2160, Math.max(720, rawH - (rawH % 2)));
+  return { width, height };
+}
